{
  "name": "@kikiutils/mongoose",
  "type": "module",
  "version": "7.0.2",
  "description": "A Mongoose plugin for enhanced JSON normalization and common schema creation, with built-in support for pagination and automatic Decimal128 conversion.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/node-mongoose.git"
  },
  "keywords": [
    "Decimal128",
    "json",
    "mongo",
    "mongoose",
    "normalization",
    "pagination",
    "plugin",
    "schema"
  ],
  "sideEffects": false,
  "exports": {
    "./_internals": {
      "types": null,
      "import": null,
      "require": null
    },
    "./package.json": "./package.json",
    "./schema-builders": {
      "types": "./dist/schema-builders/index.d.ts",
      "import": "./dist/schema-builders/index.js",
      "require": null
    },
    "./schema-builders/index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": null,
      "require": null
    },
    "./types/_internals": {
      "types": null,
      "import": null,
      "require": null
    },
    "./types/index": {
      "types": null,
      "import": null,
      "require": null
    },
    "./*": "./dist/*.js"
  },
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "es-toolkit": "^1.50.0",
    "mongoose": "^9.9.0",
    "mongoose-aggregate-paginate-v2": "^1.1.4",
    "mongoose-paginate-v2": "^1.9.5",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@kikiutils/eslint-config": "^9.2.0",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "knip": "^6.30.0",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vitest": "^4.1.10"
  }
}
