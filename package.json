{
  "name": "@kikiutils/mongoose",
  "type": "module",
  "version": "9.0.5",
  "description": "Provides Mongoose schema builders and utilities for connections, pagination, JSON normalization, and update checks.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/node-mongoose.git"
  },
  "keywords": [
    "bson",
    "decimal128",
    "json",
    "mongodb",
    "mongoose",
    "normalization",
    "pagination",
    "plugin",
    "schema",
    "schema-builder",
    "typescript",
    "uuid"
  ],
  "sideEffects": false,
  "exports": {
    "./assertions": "./dist/assertions.js",
    "./builders": "./dist/builders.js",
    "./connection": "./dist/connection.js",
    "./options": "./dist/options.js",
    "./schema-builders": "./dist/schema-builders/index.js",
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": null
    },
    "./plugins/*": "./dist/plugins/*.js",
    "./schema-builders/*": "./dist/schema-builders/*.js",
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": null
    },
    "./schema-builders/_internals": null,
    "./schema-builders/index": null,
    "./types/_internals": null,
    "./types/index": null,
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --cache --concurrency=auto --max-warnings 0",
    "lint:fix": "eslint --cache --concurrency=auto --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --clean --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "decimal.js": "^10.6.0",
    "es-toolkit": "^1.53.2",
    "mongoose": "^9.13.0",
    "mongoose-aggregate-paginate-v2": "^1.1.5",
    "mongoose-paginate-v2": "^1.9.5",
    "ts-extras": "^3.0.0",
    "type-fest": "^6.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@kikiutils/eslint-config": "^11.4.0",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.15.0",
    "knip": "^6.48.0",
    "mongoose-lean-getters": "^2.3.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.1.1"
  }
}
