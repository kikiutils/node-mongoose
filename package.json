{
  "name": "@kikiutils/mongoose",
  "type": "module",
  "version": "9.0.1",
  "description": "Provides Mongoose schema builders and utilities for connections, pagination, JSON normalization, and update checks.",
  "author": "kiki-kanri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kikiutils/node-mongoose.git"
  },
  "keywords": [
    "bson",
    "decimal128",
    "json",
    "mongodb",
    "mongoose",
    "normalization",
    "pagination",
    "plugin",
    "schema",
    "schema-builder",
    "typescript",
    "uuid"
  ],
  "sideEffects": false,
  "exports": {
    "./assertions": "./dist/assertions.js",
    "./builders": "./dist/builders.js",
    "./connection": "./dist/connection.js",
    "./options": "./dist/options.js",
    "./plugins/assertions": "./dist/plugins/assertions.js",
    "./plugins/lean-decimal128-to-string": "./dist/plugins/lean-decimal128-to-string.js",
    "./plugins/normalize": "./dist/plugins/normalize.js",
    "./schema-builders": "./dist/schema-builders/index.js",
    "./schema-builders/base": "./dist/schema-builders/base.js",
    "./schema-builders/bigint": "./dist/schema-builders/bigint.js",
    "./schema-builders/boolean": "./dist/schema-builders/boolean.js",
    "./schema-builders/date": "./dist/schema-builders/date.js",
    "./schema-builders/decimal128": "./dist/schema-builders/decimal128.js",
    "./schema-builders/double": "./dist/schema-builders/double.js",
    "./schema-builders/int32": "./dist/schema-builders/int32.js",
    "./schema-builders/mixed": "./dist/schema-builders/mixed.js",
    "./schema-builders/number": "./dist/schema-builders/number.js",
    "./schema-builders/object-id": "./dist/schema-builders/object-id.js",
    "./schema-builders/ref": "./dist/schema-builders/ref.js",
    "./schema-builders/string": "./dist/schema-builders/string.js",
    "./schema-builders/uuid": "./dist/schema-builders/uuid.js",
    "./types": "./dist/types/index.js",
    "./types/aggregate-paginate": "./dist/types/aggregate-paginate.js",
    "./types/data": "./dist/types/data.js",
    "./types/options": "./dist/types/options.js",
    "./types/paginate": "./dist/types/paginate.js",
    "./package.json": "./package.json"
  },
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "bumplog": "changelogen --bump --hideAuthorEmail",
    "knip:deps": "knip --dependencies",
    "knip:exports": "knip --exports",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && changelogen --hideAuthorEmail --push --release && npm publish",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependenciesMeta": {},
  "dependencies": {
    "decimal.js": "^10.6.0",
    "es-toolkit": "^1.53.1",
    "mongoose": "^9.11.4",
    "mongoose-aggregate-paginate-v2": "^1.1.5",
    "mongoose-paginate-v2": "^1.9.5",
    "type-fest": "^5.10.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@kikiutils/eslint-config": "^9.3.2",
    "@kikiutils/tsconfigs": "^7.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "changelogen": "^0.6.2",
    "eslint": "^10.14.0",
    "knip": "^6.44.0",
    "mongoose-lean-getters": "^2.3.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "unplugin-unused": "^0.6.0",
    "vitest": "^5.0.5"
  }
}
